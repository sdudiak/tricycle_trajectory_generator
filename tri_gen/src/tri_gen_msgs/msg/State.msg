float64 x # X position in the map frame
float64 y # Y position in the map frame
float64 theta # orientation of the entire platform
float64 phi # steering angle of the front wheel
float64 omega_phi # angular velocity of the steering angle (dphi/dt)
float64 v # linear velocity of the drive wheel
builtin_interfaces/Duration stamp_from_start # time since the beginning of the trajectory
