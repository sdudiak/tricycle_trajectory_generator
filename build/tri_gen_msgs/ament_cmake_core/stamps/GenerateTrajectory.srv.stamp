# Service for generating a trajectory between a start and goal state,
# given dynamic and geometric constraints.

State start # initial state
State goal # goal state
float64 dt # trajectory sampling time step (in seconds)
float64 phi_min
float64 phi_max
float64 omega_phi_min
float64 omega_phi_max
float64 v_min
float64 v_max
float64 a_min
float64 a_max
---
Trajectory trajectory
float64 total_length # total trajectory length (meters)
float64 max_velocity # maximum linear velocity in the trajectory
float64 max_curvature # maximum trajectory curvature (1/turn radius)
float64 generation_time_ms # trajectory generation time in milliseconds
bool success # success flag
string message # descriptive message
